{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "syringe-control-surface/Install Remote Script",
            "type": "process",
            "command": "${workspaceFolder}/../.venv/bin/python",
            "args": [
                "installAbletonRemoteScript"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "${workspaceFolder}/../.venv/bin:/opt/local/bin:/opt/local/sbin:/usr/local/bin:/usr/bin:/bin"
                }
            },
            "problemMatcher": [],
            "presentation": {
              "echo": true,
              "reveal": "always",
              "focus": false,
              "panel": "shared",
              "showReuseMessage": false,
              "clear": true
            },
            "runOptions": {
              "runOn": "default"
            }
        }
    ]
}
